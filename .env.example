# ---------------------------------------------------------------------------
# Rutgers course-opening notifier — example configuration
#
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real tokens.
#
# This project needs NO Rutgers credentials. It only reads the public Schedule
# of Classes. Do not put your NetID, password, RUID, PAC or Duo codes anywhere.
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# Get this from @BotFather in Telegram: /newbot, then copy the token it gives you.
# Looks like: 123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat id (a number). Message @userinfobot to find it.
# Used when a CLI command is run without an explicit --chat-id.
DEFAULT_TELEGRAM_CHAT_ID=

# --- Rutgers defaults -----------------------------------------------------
# Campus: NB = New Brunswick, NK = Newark, CM = Camden
RUTGERS_CAMPUS=NB

# The academic year of the term you are registering for.
RUTGERS_YEAR=2026

# One of: fall, spring, summer, winter
RUTGERS_TERM=fall

# --- Monitoring behaviour -------------------------------------------------
# How often to check, in seconds. 30 is a good, polite default.
# Do not set this very low: it is rude to Rutgers and will not help you.
POLL_INTERVAL_SECONDS=30

# Random extra delay (0..N seconds) added to each interval so requests are not
# perfectly periodic.
POLL_JITTER_SECONDS=5

# While Rutgers is failing, the poll interval doubles per failed cycle up to
# this ceiling, then snaps back to POLL_INTERVAL_SECONDS on the first success.
# Retries inside one request handle a blip; this handles a sustained outage.
MAX_POLL_INTERVAL_SECONDS=600

# Keep re-alerting every this many minutes while a section is STILL open and you
# have not confirmed you registered. Replying "yes" stops the watch and so ends
# the repeats; replying "no" keeps them coming. Repeats also stop on their own if
# the section closes again. 0 disables repeats (one alert per opening).
REPEAT_ALERT_MINUTES=5

# After alerting you that a section opened, wait this many minutes and then ask
# "did you get in?". Answering "yes" stops the watch; "no" keeps it running.
# 0 disables the question entirely.
FOLLOWUP_AFTER_MINUTES=15

# If Rutgers has been unreachable continuously for this many minutes, send one
# warning message to Telegram.
FAILURE_ALERT_AFTER_MINUTES=15

# --- Reply listener ---------------------------------------------------------
# Listen on this bot's own inbox for a yes/no answer to "did you get in?".
# The listener can ONLY record that answer: it cannot add or stop watches, and
# there is no LLM behind it. Anything else it receives is ignored.
REPLY_LISTENER_ENABLED=false

# Chat ids allowed to answer, comma-separated. Leave empty to allow any chat
# that already has a watch (which is self-limiting).
REPLY_ALLOWED_CHAT_IDS=

# --- Storage & logging ----------------------------------------------------
DATABASE_PATH=./data/rutgers-sniper.sqlite
LOG_LEVEL=info

# --- Advanced (defaults are fine) ----------------------------------------
# How long the large course catalog is cached in memory, in minutes.
CATALOG_CACHE_MINUTES=60

# Per-request timeout in milliseconds.
HTTP_TIMEOUT_MS=20000

# Public Rutgers Schedule of Classes API. Change only if Rutgers moves it.
SOC_BASE_URL=https://classes.rutgers.edu/soc/api

TELEGRAM_API_BASE_URL=https://api.telegram.org
